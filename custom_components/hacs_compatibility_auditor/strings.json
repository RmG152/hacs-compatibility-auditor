{
  "config": {
    "step": {
      "user": {
        "title": "HACS Compatibility Auditor",
        "description": "Configure HACS package compatibility auditing.",
        "data": {
          "github_token": "GitHub token (optional, for higher API quota)",
          "check_interval": "Check interval (hours)",
          "cache_hours": "GitHub query cache hours",
          "github_timeout": "GitHub query timeout (seconds)",
          "github_retries": "GitHub query retries"
        }
      }
    },
    "error": {
      "cannot_connect": "Could not connect to the GitHub API",
      "invalid_token": "Invalid GitHub token",
      "hacs_not_found": "HACS is not installed or its data could not be accessed",
      "invalid_repo_format": "Repository must be in 'owner/repo' format"
    },
    "abort": {
      "already_configured": "The integration is already configured"
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "HACS Compatibility Auditor Options",
        "description": "Adjust audit settings. Community rules help reduce false positives by providing curated compatibility data.",
        "data": {
          "github_token": "GitHub token (optional)",
          "check_interval": "Check interval (hours)",
          "cache_hours": "Cache hours",
          "issue_labels_priority": "High-priority GitHub labels (comma-separated)",
          "ignore_list": "Packages to ignore (repo names, comma-separated)",
          "github_timeout": "GitHub query timeout (seconds)",
          "github_retries": "GitHub query retries",
          "rules_enabled": "Use community rules",
          "rules_repo": "Rules repository (owner/repo)",
          "batch_size": "Batch size (packages checked concurrently)",
          "ai_enabled": "Enable AI analysis",
          "ai_auto_analyze": "Auto-analyze with AI during batch scan",
          "manage_ai_providers": "Configure AI providers (check to manage)"
        }
      },
      "ai_providers": {
        "title": "AI Providers",
        "description": "{providers}",
        "data": {
          "action": "Action"
        }
      },
      "ai_add_provider": {
        "title": "Add/Edit AI Provider",
        "description": "Configure an AI provider. For Ollama, API key is not needed.",
        "data": {
          "provider_type": "Provider type",
          "name": "Provider name",
          "api_key": "API key",
          "base_url": "Base URL",
          "model": "Model",
          "max_tokens": "Max tokens",
          "temperature": "Temperature"
        }
      }
    },
    "error": {
      "provider_name_required": "Provider name is required",
      "provider_model_required": "Model name is required",
      "provider_url_required": "Base URL is required",
      "provider_key_required": "API key is required for this provider type"
    }
  },
  "entity": {
    "sensor": {
      "ha_version_current": {
        "name": "HA Current"
      },
      "ha_version_next": {
        "name": "HA Next"
      },
      "hacs_packages_total": {
        "name": "Packages Total"
      },
      "hacs_incompatible_count": {
        "name": "Incompatible"
      },
      "hacs_package": {
        "name": "Package"
      }
    }
  },
  "services": {
    "check_now": {
      "name": "Force check",
      "description": "Forces an immediate re-check of all HACS package compatibility."
    },
    "check_package": {
      "name": "Check package",
      "description": "Checks compatibility of a single HACS package by repository (format owner/repo).",
      "fields": {
        "repository": {
          "name": "Repository",
          "description": "Full repository name (e.g. 'home-assistant/core')"
        }
      }
    },
    "ai_analyze_package": {
      "name": "Analyze with AI",
      "description": "Uses an AI provider to analyze if a HACS package has real compatibility issues.",
      "fields": {
        "repository": {
          "name": "Repository",
          "description": "Full repository name (e.g. 'owner/repo')"
        },
        "provider": {
          "name": "AI Provider",
          "description": "Name of the AI provider to use (optional, uses first configured)"
        }
      }
    },
    "ai_categorize_issue": {
      "name": "Categorize issue with AI",
      "description": "Uses AI to categorize a specific GitHub issue.",
      "fields": {
        "repository": {
          "name": "Repository",
          "description": "Full repository name (e.g. 'owner/repo')"
        },
        "issue_number": {
          "name": "Issue number",
          "description": "GitHub issue number"
        },
        "provider": {
          "name": "AI Provider",
          "description": "Name of the AI provider to use (optional)"
        }
      }
    },
    "report_to_rules": {
      "name": "Report to rules repository",
      "description": "Creates a GitHub issue on the community rules repository with AI analysis.",
      "fields": {
        "repository": {
          "name": "Repository",
          "description": "Full repository name of the affected package"
        },
        "issue_number": {
          "name": "Issue number",
          "description": "GitHub issue number being reported"
        },
        "category": {
          "name": "Category",
          "description": "AI categorization result"
        },
        "reasoning": {
          "name": "Reasoning",
          "description": "AI reasoning for the categorization"
        },
        "action": {
          "name": "Action",
          "description": "Type of report (add_false_positive or report_incompatibility)"
        }
      }
    }
  }
}
