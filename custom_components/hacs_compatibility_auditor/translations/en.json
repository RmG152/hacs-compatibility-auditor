        }
      }
    }
  },
  "entity": {
    "sensor": {
      "ha_version_current": {
        "name": "HCA Current HA version"
      },
      "ha_version_next": {
        "name": "HCA Next HA version"
      },
      "hacs_packages_total": {
        "name": "HCA Total HACS packages"
      },
      "hacs_incompatible_count": {
        "name": "HCA Incompatible packages"
      },
      "hacs_package": {
        "name": "HCA HACS Package"
